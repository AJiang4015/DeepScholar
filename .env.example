# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
# API Key 优先级：系统环境变量 BAILIAN_API_KEY（阿里云百炼平台）> 下方 OPENAI_API_KEY
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=

# RAGFlow 配置
RAGFLOW_API_URL=https://cloud.ragflow.io
RAGFLOW_API_KEY=

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# Agent 执行状态 checkpoint（R2 演进：backend 抽象，2026-09）
# AGENT_CHECKPOINT_BACKEND: "sqlite"(缺省, local/test) | "postgres"(生产)
#   sqlite 后端：官方 AsyncSqliteSaver，路径见 AGENT_CHECKPOINT_DB（默认 app/runtime/checkpoints.sqlite，已 gitignore）
#   postgres 后端：官方 AsyncPostgresSaver + AsyncConnectionPool（FastAPI lifespan 管理），
#   checkpoint 表族由 saver.setup() 自动创建/迁移（勿手动改表）
# AGENT_CHECKPOINT_BACKEND=sqlite
# AGENT_CHECKPOINT_DB=C:/path/to/agent-checkpoints.sqlite
# AGENT_CHECKPOINT_DSN=postgresql://user:password@host:5432/dbname?sslmode=disable
# 测试用（PG integration/replay/recovery 只允许指向独立测试库，禁止指向开发/生产库）：
# AGENT_CHECKPOINT_DSN_TEST=postgresql://user:password@localhost:5432/dbname_test?sslmode=disable

# Research Artifact Store（F1，与 checkpoint 独立的数据面；缺省 sqlite 本地 fallback）
# RESEARCH_STORE: "sqlite"(缺省) | "postgres"(生产) | "disabled"
#   sqlite：RESEARCH_DB 覆盖（默认 app/runtime/research.sqlite，已 gitignore）
#   postgres：RESEARCH_DSN 必填；research_* 表族由 app/research/migrations 版本化自管
# RESEARCH_STORE=sqlite
# RESEARCH_DB=C:/path/to/research.sqlite
# RESEARCH_DSN=postgresql://user:password@host:5432/dbname?sslmode=disable
# 测试用（PG 集成测试只允许指向独立测试库）：
# RESEARCH_DSN_TEST=postgresql://user:password@localhost:5432/dbname_test?sslmode=disable
